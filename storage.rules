rules_version = '2';

// Invoice files (#373): the supplier's invoice on a company cost, an issued
// invoice on an invoice. Owner only, one level under company-files, at most
// 10 MB, and only the three kinds the app accepts: FatturaPA XML, the same
// signed (.xml.p7m), and PDF. The adapter names every object <id>.xml,
// <id>.xml.p7m or <id>.pdf and sets the content type from the kind; the rules
// check both, so a renamed or mistyped upload is refused here, not only in the
// slot. 10485760 is INVOICE_FILE_MAX_BYTES in src/lib/invoice-files.ts.
//
// One uid only (#389): sign-up is closed, but a stranger's account must not be
// able to store 10 MB objects on the owner's bill either. `isAllowedUser` holds
// the same uid as firestore/base.rules and apps/web/src/lib/owner-uid.ts;
// firestore-rules-owner.test.ts fails if they drift. The emulator suite opens
// this one function (rules-source.ts) because it signs up random users.
//
// Everything else in the bucket stays closed: no rule, no access.

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/company-files/{file} {
      function isAllowedUser() {
        return request.auth.uid == 'AF95t2LVcpYfm9iecrisGyaM2mC2';
      }
      function owner() {
        return request.auth != null && isAllowedUser() && request.auth.uid == uid;
      }
      function validUpload() {
        return request.resource.size <= 10485760
          && ((file.matches('.+[.]xml') && request.resource.contentType in ['application/xml', 'text/xml'])
            || (file.matches('.+[.]xml[.]p7m') && request.resource.contentType in ['application/pkcs7-mime', 'application/x-pkcs7-mime'])
            || (file.matches('.+[.]pdf') && request.resource.contentType == 'application/pdf'));
      }

      allow read, delete: if owner();
      allow create, update: if owner() && validUpload();
    }
  }
}
